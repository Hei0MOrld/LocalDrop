{
  "manifest_version": 3,
  "name": "LocalDrop",
  "version": "1.0",
  "description": "Pixel & Mac間でAirDropのようにファイル転送",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://192.168.0.0/16/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}